{
  "name": "hermes-agent-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:api": "tsc -b && vite build --mode api --outDir dist-api",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "mock:init": "msw init public --save"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "@tanstack/react-query": "5.104.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.52.0",
    "recharts": "3.10.1",
    "zod": "4.6.5",
    "msw": "2.15.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2",
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
